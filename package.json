{
  "name": "muscle-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:rig": "node scripts/validate-curl.mjs",
    "test:assets": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "playwright test",
    "test:pulldown": "node scripts/validate-pulldown.mjs",
    "quality:audit": "node scripts/quality/motion-audit.mjs",
    "quality:gate": "node scripts/quality/gate.mjs",
    "test:quality": "node --test tests/quality/*.node.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "dexie": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
