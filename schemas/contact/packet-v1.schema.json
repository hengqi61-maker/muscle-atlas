{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coordinates",
    "variant",
    "provenance",
    "toleranceM",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "coordinates": {
      "const": "right-handed-metres-seconds-column-major-active"
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "toleranceM": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.0001
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeSeconds",
          "prop",
          "hands"
        ],
        "properties": {
          "timeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "prop": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "worldMatrix",
              "dimensionsM",
              "vertices",
              "triangles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "worldMatrix": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 16,
                "maxItems": 16
              },
              "dimensionsM": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "vertices": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "triangles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          },
          "hands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "side",
                "skeletonId",
                "wristWorldMatrix",
                "palmWorldMatrix",
                "sources",
                "frameStatus"
              ],
              "properties": {
                "side": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "skeletonId": {
                  "type": "string",
                  "minLength": 1
                },
                "wristWorldMatrix": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 16,
                      "maxItems": 16
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "palmWorldMatrix": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 16,
                      "maxItems": 16
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sourceId",
                      "originalMeshSha256",
                      "posedWorldVertices",
                      "triangles"
                    ],
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "originalMeshSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "posedWorldVertices": {
                        "type": "array",
                        "minItems": 3,
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        }
                      },
                      "triangles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 3,
                          "maxItems": 3
                        }
                      }
                    }
                  }
                },
                "frameStatus": {
                  "enum": [
                    "provided",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
